# =====================================================================
# PLATAFORMA ALUMVID - EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# =====================================================================

GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

DB_HOST=localhost
DB_PORT=5433
DB_NAME=alumvid_db
DB_USER=alumvid_admin
DB_PASSWORD=cambia_esta_clave_segura

MASTER_IDENTIFICATION=1700000000
MASTER_NAME=Administrador General AlumVid
MASTER_PASSWORD=UnaClaveSeguraDe12OMas!

JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_256_bits
JWT_EXPIRATION_HOURS=24

GATEWAY_PORT=8080
USUARIOS_SERVICE_PORT=8081
INVENTARIO_SERVICE_PORT=8082
LOGISTICA_SERVICE_PORT=8083

# Retazos y piezas físicas
RETAZOS_SERVICE_PORT=8084

PEDIDOS_SERVICE_PORT=8085

UBICACIONES_SERVICE_PORT=8086

# JDBC opcional: descomentar solo si se usa una URL JDBC completa.
# DB_URL=jdbc:postgresql://host:5432/alumvid_db?sslmode=require
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
DB_INIT_TIMEOUT=60000

# Apps: se puede cambiar de entorno sin volver a compilarlas.
# LOCAL_API_URL para el teléfono real = http://IP-DE-LA-PC:8080
LOCAL_API_URL=http://localhost:8080
RAILWAY_API_URL=
# No contiene /api/v1; debe ser el dominio HTTPS público del gateway.
