# Base externa Railway: usar el host/puerto públicos TCP para una PC fuera de Railway.
DB_HOST=HOST_PUBLICO_DE_LA_BASE
DB_PORT=5432
DB_NAME=alumvid_db
DB_USER=alumvid_admin
DB_PASSWORD=REEMPLAZAR
DB_SSLMODE=require
DB_POOL_SIZE=5
MASTER_IDENTIFICATION=IDENTIFICACION_VALIDA
MASTER_NAME=Administrador principal
MASTER_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA
JWT_SECRET=REEMPLAZAR_CON_BASE64_ALEATORIO
JWT_EXPIRATION_HOURS=24
GOOGLE_MAPS_API_KEY=
GATEWAY_PORT=8080
# Si la base elegida no ofrece TLS, usar prefer solo por el túnel/red apropiados.
