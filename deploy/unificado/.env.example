# Railway: PostGIS is the name of the existing database component.
PORT=8080
SERVER_ADDRESS=::
DB_HOST=${{PostGIS.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_NAME=${{PostGIS.POSTGRES_DB}}
DB_USER=${{PostGIS.POSTGRES_USER}}
DB_PASSWORD=${{PostGIS.POSTGRES_PASSWORD}}
DB_SSLMODE=prefer
DB_POOL_SIZE=4
MASTER_IDENTIFICATION=REEMPLAZAR_IDENTIFICACION
MASTER_NAME=Administrador principal
MASTER_PASSWORD=REEMPLAZAR_CONTRASENA
JWT_SECRET=REEMPLAZAR_SECRETO_LARGO
JWT_EXPIRATION_HOURS=24
GOOGLE_MAPS_API_KEY=REEMPLAZAR_API_KEY
