# Copiar estos valores al servicio correspondiente en Railway, nunca subir las claves.
# PostgreSQL + PostGIS (servicio postgres, volumen /var/lib/postgresql/data):
POSTGRES_DB=alumvid_db
POSTGRES_USER=alumvid_admin
POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_ALEATORIA
PGDATA=/var/lib/postgresql/data/pgdata

# Compartidas por los seis microservicios:
DB_HOST=${{postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_NAME=${{postgres.POSTGRES_DB}}
DB_USER=${{postgres.POSTGRES_USER}}
DB_PASSWORD=${{postgres.POSTGRES_PASSWORD}}
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
SERVER_ADDRESS=::
AUTH_URL=http://${{usuarios.RAILWAY_PRIVATE_DOMAIN}}:8081
PEDIDOS_URL=http://${{pedidos.RAILWAY_PRIVATE_DOMAIN}}:8085

# Usuarios (PORT=8081), logística (PORT=8083): mismo JWT_SECRET.
MASTER_IDENTIFICATION=IDENTIFICACION_VALIDA_DEL_PRINCIPAL
MASTER_NAME=Administrador principal
MASTER_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA
JWT_SECRET=REEMPLAZAR_CON_BASE64_ALEATORIO_DE_64_BYTES
JWT_EXPIRATION_HOURS=24
GOOGLE_MAPS_API_KEY=

# Gateway, único dominio público; PORT=8080.
AUTH_SERVICE_URL=http://${{usuarios.RAILWAY_PRIVATE_DOMAIN}}:8081
INVENTARIO_SERVICE_URL=http://${{inventario.RAILWAY_PRIVATE_DOMAIN}}:8082
LOGISTICA_SERVICE_URL=http://${{logistica.RAILWAY_PRIVATE_DOMAIN}}:8083
RETAZOS_SERVICE_URL=http://${{retazos.RAILWAY_PRIVATE_DOMAIN}}:8084
PEDIDOS_SERVICE_URL=http://${{pedidos.RAILWAY_PRIVATE_DOMAIN}}:8085
UBICACIONES_SERVICE_URL=http://${{ubicaciones.RAILWAY_PRIVATE_DOMAIN}}:8086
